<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.sisano.controller.PacientesController"
            stylesheets="@estilos.css">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <center>
        <TableView fx:id="tablaPacientes">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn text="DNI" prefWidth="100" style="-fx-alignment: CENTER;">
                    <cellValueFactory><PropertyValueFactory property="dni"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Paciente" prefWidth="200">
                    <cellValueFactory><PropertyValueFactory property="nombre"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Email" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="email"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Teléfono" prefWidth="100" style="-fx-alignment: CENTER;">
                    <cellValueFactory><PropertyValueFactory property="telefono"/></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </center>
    
    <right>
        <VBox spacing="15" prefWidth="320" styleClass="panel-lateral">
            
            <Label text="Expediente Paciente" styleClass="titulo-modulo"/>
            <Separator/>
            
            <VBox spacing="5">
                <Label text="Identificación (DNI):" styleClass="label-campo"/>
                <HBox spacing="10">
                    <TextField fx:id="txtDni" promptText="Número de Documento" HBox.hgrow="ALWAYS"/>
                    

                    <Button text="🔍" onAction="#buscarPorDni" styleClass="btn-icon">
                        <tooltip>
                            <Tooltip text="Buscar si existe en base de datos"/>
                        </tooltip>
                    </Button>
                </HBox>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Datos Personales:" styleClass="label-campo"/>
                <TextField fx:id="txtNombre" promptText="Apellidos y Nombres"/>
                
                <HBox spacing="10">
                    <DatePicker fx:id="dpFechaNacimiento" promptText="F. Nacimiento" 
                                style="-fx-pref-height: 35;" HBox.hgrow="ALWAYS"/>
                                
                    <ComboBox fx:id="comboGenero" promptText="Género" prefWidth="110"/>
                </HBox>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Contacto:" styleClass="label-campo"/>
                <TextField fx:id="txtTelefono" promptText="Celular / WhatsApp"/>
                <TextField fx:id="txtEmail" promptText="correo@ejemplo.com"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" />
            <Separator/>
            
            <HBox spacing="10" alignment="CENTER">
                <Button text="Guardar Ficha" onAction="#guardar" 
                        styleClass="btn-primary" prefWidth="140"/>
                        
                <Button text="Dar de Baja" onAction="#eliminar" 
                        styleClass="btn-danger-outline" prefWidth="100"/>
            </HBox>
            
        </VBox>
    </right>
</BorderPane>