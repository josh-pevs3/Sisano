<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.sisano.controller.CitasController"
            stylesheets="@styles.css">
    
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 0 0 1 0;">
                <Button text="&lt;" onAction="#semanaAnterior" styleClass="btn-icon" prefWidth="50" style="-fx-font-size: 16px;"/>
                
                <Label fx:id="lblPeriodo" text="Cargando..." 
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                
                <Button text="&gt;" onAction="#semanaSiguiente" styleClass="btn-icon" prefWidth="50" style="-fx-font-size: 16px;"/>
            </HBox>
            
            <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #f9f9f9;">
                <Label text="Ver agenda de Sala:" styleClass="label-campo"/>
                <ComboBox fx:id="comboSalas" prefWidth="200" promptText="Seleccione Consultorio..."/>
                
                <Separator orientation="VERTICAL"/>

                <Label text="Filtrar Médico:" styleClass="label-campo"/>
                <ComboBox fx:id="comboMedicos" prefWidth="200" promptText="Todos los médicos"/>
                
                <Separator orientation="VERTICAL"/>
                
                <Label fx:id="lblEstadoAccion" text="Modo: Lectura" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" onAction="#renderizarCalendario" styleClass="btn-icon"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
            <GridPane fx:id="gridCalendario" styleClass="grid-calendario">
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" minWidth="60" prefWidth="60" halignment="CENTER"/>
                    <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ColumnConstraints hgrow="ALWAYS" maxWidth="Infinity"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints vgrow="NEVER" minHeight="50"/>
                </rowConstraints>
            </GridPane>
        </ScrollPane>
    </center>
</BorderPane>